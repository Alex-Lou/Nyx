# Scripts exécutés dans Linux (capsule WSL) : toujours LF, même cloné sous Windows.
*.sh  text eol=lf
# Scripts Windows : CRLF.
*.ps1 text eol=crlf
# Gradle wrapper (Android) : script Unix en LF, batch en CRLF, jar binaire.
android/gradlew     text eol=lf
android/gradlew.bat text eol=crlf
*.jar binary
