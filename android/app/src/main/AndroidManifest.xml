<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Appareils liés : Wi-Fi actif ? (ConnectivityManager) et réception des
         annonces mDNS du PC (WifiManager.MulticastLock, pendant la
         découverte seulement). Aucune n'est « dangereuse ». -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Téléchargements vers Download/ : inutile à partir d'Android 10 (API 29). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Demandées à la volée, après accord explicite pour chaque site (visio,
         cartes) ; la caméra sert aussi au scan du QR d'appairage (Appareils
         liés). Aucune n'est accordée automatiquement. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Caméra et GPS facultatifs : l'app s'installe aussi sans. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- usesCleartextTraffic : un navigateur doit pouvoir ouvrir les sites http://
         (la WebView applique la network security config de l'app). -->
    <application
        android:name=".NyxApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nyx"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Nyx.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- Écrans secondaires (coffre) : internes, jamais exportés. -->
        <activity
            android:name=".LibraryActivity"
            android:exported="false"
            android:theme="@style/Theme.Nyx"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Nyx"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".DevicesActivity"
            android:exported="false"
            android:theme="@style/Theme.Nyx"
            android:windowSoftInputMode="adjustResize" />

        <!-- Scanner QR (zxing-android-embedded) : portrait autorisé (la
             bibliothèque impose le paysage par défaut). -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />
    </application>
</manifest>
